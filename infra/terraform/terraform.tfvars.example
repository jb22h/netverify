# Copy to terraform.tfvars locally if you need to override defaults.
# terraform.tfvars is gitignored — never commit secrets.

project_name = "netverify"
environment  = "portfolio"
aws_region   = "eu-central-1"

# tags = {
#   Owner = "your-name"
# }

# --- Managed data plane (required before plan/apply) ---
# db_password has no default. Set a strong local-only value; never commit it.
db_password = "CHANGE_ME_LOCAL_ONLY"

# Optional overrides (defaults shown):
# db_engine_version  = "18.6"
# db_instance_class  = "db.t4g.micro"
# db_name            = "netverify"
# db_username        = "netverify"
